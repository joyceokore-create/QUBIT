DATABASE_URL="postgresql://qubit:qubit@localhost:5432/qubit?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# Encrypts TOTP MFA secrets at rest (src/lib/mfa.ts) — generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"
# Optional SSO (Phase D)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Q copilot (MVP1 Phase C). OpenAI-compatible Chat Completions provider (e.g. an internal
# agentic box). Server-only. When unset, Q falls back to deterministic (non-LLM) reports
# built from the same tenant-scoped data. Never commit a real key.
Q_AI_BASE_URL=
Q_AI_API_KEY=
Q_AI_MODEL=qwen3-14b

# Encrypts integration access tokens at rest (src/lib/secret-box.ts). Optional — falls
# back to MFA_ENCRYPTION_KEY if unset. Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Demo mode: Q simulates AI answers from live data without a provider (auto-off when Q_AI_API_KEY set).
Q_MOCK_AI=

# ── Revamp M0 backbone (docs/16-revamp-plan.md) ──
# Shared secret for POST /api/internal/cron (host crontab → jobs runtime, DM1.15 №4).
# Jobs never run without it. Generate: openssl rand -hex 32
CRON_SECRET=

# Feature flags — default OFF; set to "1"/"true"/"on" to enable (src/lib/flags.ts).
FEATURE_SPACES=
FEATURE_EMAIL=
FEATURE_COMMIT_AUTOMATION=
