{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/upstream-check.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking origin/Development for teammates' changes…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/upstream-check.sh 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
