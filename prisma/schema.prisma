// QUBIT — Phase A schema. See docs/05-data-model.md and docs/04-multitenancy.md.
// Every tenant-owned table carries tenant_id and is covered by prisma/rls.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  brandColor String   @map("brand_color")
  brandLight String   @map("brand_light")
  // Email domains that resolve to this tenant at login (src/lib/tenant-domain.ts). Prisma
  // can't express uniqueness across array values, so "a domain belongs to only one
  // tenant" is enforced in application code (resolveTenantByEmailDomain takes the first
  // match; keep domain lists disjoint when configuring tenants).
  domains    String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  orgUnits         OrgUnit[]
  users            User[]
  roleAssignments  RoleAssignment[]
  departments      Department[]
  portfolios       Portfolio[]
  programmes       Programme[]
  projects         Project[]
  projectOrgStatus ProjectOrgStatus[]
  milestones       Milestone[]
  risks            Risk[]
  issues           Issue[]
  auditLogs        AuditLog[]

  @@map("tenant")
}

model OrgUnit {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  flag      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectOrgStatuses ProjectOrgStatus[]
  departments        Department[]

  @@unique([tenantId, code])
  @@map("org_unit")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email                   String
  name                    String
  passwordHash            String?  @map("password_hash")
  previousPasswordHashes  String[] @default([]) @map("previous_password_hashes")
  mfaSecret               String?  @map("mfa_secret") // encrypted at rest, see src/lib/mfa.ts
  status                  String   @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "DELETED"
  deletedAt               DateTime? @map("deleted_at")
  departmentId            String?     @map("department_id")
  department              Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  // Who this user reports to. Self-relation — see docs/05-data-model.md. Longer manager
  // cycles (A -> B -> A) aren't guarded; nothing today traverses this chain beyond a
  // direct lookup, so it's inert bad data rather than an active bug (unlike Department's
  // parentId, which IS walked for cycle prevention because hierarchy queries rely on it).
  managerId               String?  @map("manager_id")
  manager                 User?    @relation("UserManager", fields: [managerId], references: [id])
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  roles             RoleAssignment[]
  reports           User[]           @relation("UserManager")
  headOfDepartments Department[]     @relation("DepartmentHead")

  @@unique([tenantId, email])
  @@map("user")
}

// Org-structure hierarchy — ships empty (see docs/05-data-model.md). Optionally scoped to
// an OrgUnit (subsidiary/country) so KCB can model per-country departments while Riverbank
// (effectively one HQ org unit) leaves it unset. No @@unique on name: department names
// aren't guaranteed unique within a tenant (two different parents can each have an
// "Operations" child), and a composite unique with a nullable orgUnitId wouldn't help
// anyway since Postgres treats NULL as distinct.
model Department {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  name       String
  orgUnitId  String?      @map("org_unit_id")
  orgUnit    OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  parentId   String?      @map("parent_id")
  parent     Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children   Department[] @relation("DepartmentHierarchy")
  headUserId String?      @map("head_user_id")
  // Purely informational — being set as a department's head does NOT grant the
  // (unrelated, pre-existing) DepartmentHead RBAC role.
  headUser   User?        @relation("DepartmentHead", fields: [headUserId], references: [id])
  members    User[]       @relation("UserDepartment")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, parentId])
  @@index([tenantId, orgUnitId])
  @@map("department")
}

model RoleAssignment {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  role      String
  scopeType String?  @map("scope_type")
  scopeId   String?  @map("scope_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("role_assignment")
}

model Portfolio {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  type         String?
  ownerId      String?  @map("owner_id")
  targetBudget String?  @map("target_budget")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  programmes Programme[]
  projects   Project[]

  @@map("portfolio")
}

model Programme {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  portfolioId String?    @map("portfolio_id")
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id])
  name        String
  description String?
  status      String
  budget      String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  projects Project[]

  @@map("programme")
}

model Project {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  description String?
  type        String
  portfolioId String?    @map("portfolio_id")
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id])
  programmeId String?    @map("programme_id")
  programme   Programme? @relation(fields: [programmeId], references: [id])
  priority    String
  status      String
  dueDate     DateTime?  @map("due_date")
  budget      String?
  // Free-text placeholder (e.g. "Project Lead, Contributor") — real per-person assignment
  // belongs to Resource/Allocation (Phase C), not invented here. Never real employee names.
  team        String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  orgStatuses ProjectOrgStatus[]
  risks       Risk[]
  issues      Issue[]

  @@unique([tenantId, code])
  @@map("project")
}

model ProjectOrgStatus {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  orgUnitId String   @map("org_unit_id")
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id])
  progress  Int
  status    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  milestones Milestone[]

  @@unique([projectId, orgUnitId])
  @@map("project_org_status")
}

model Milestone {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  projectOrgStatusId String           @map("project_org_status_id")
  parent             ProjectOrgStatus @relation(fields: [projectOrgStatusId], references: [id])
  name               String
  sequence           Int
  state              String
  dueDate            DateTime?        @map("due_date")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("milestone")
}

model Risk {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  projectId   String?  @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id])
  title       String
  description String?
  category    String?
  probability Int
  impact      Int
  mitigation  String?
  ownerId     String?  @map("owner_id")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  issue Issue?

  @@map("risk")
}

model Issue {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  projectId    String?  @map("project_id")
  project      Project? @relation(fields: [projectId], references: [id])
  originRiskId String?  @unique @map("origin_risk_id")
  originRisk   Risk?    @relation(fields: [originRiskId], references: [id])
  title        String
  severity     String
  ownerId      String?  @map("owner_id")
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("issue")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
