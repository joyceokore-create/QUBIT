# QUBIT — production environment (copy to your host's secret store; never commit real values).
# Generate each secret with: openssl rand -base64 32

# ── Database (managed Postgres 17) ─────────────────────────────────────────────
# Use a pooled connection string from your provider. RLS is enforced in-DB, so the
# app role must be a NORMAL role (NOT superuser / NOT BYPASSRLS) or tenant isolation
# is silently defeated. Keep sslmode=require.
DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@HOST:5432/qubit?schema=public&sslmode=require"

# ── Auth (NextAuth v5) ─────────────────────────────────────────────────────────
AUTH_SECRET="REPLACE_openssl_rand_base64_32"
AUTH_URL="https://qubit.YOURDOMAIN.com"

# Encrypts TOTP MFA secrets at rest (src/lib/mfa.ts). Rotating this invalidates every
# enrolled authenticator — users must re-enroll. Store it, don't regenerate casually.
MFA_ENCRYPTION_KEY="REPLACE_openssl_rand_base64_32"

# ── Q copilot (OpenAI-compatible AI provider) ──────────────────────────────────
# Server-only. An internal agentic box (OpenAI-compatible Chat Completions) keeps tenant
# data in-house. When unset, Q still works — it returns deterministic reports built from
# the same tenant-scoped data. Set these to enable model-authored narratives & chat.
Q_AI_BASE_URL="https://rbsai.rbrc.io/v1"
Q_AI_API_KEY="<bearer-token>"
Q_AI_MODEL="qwen3-14b"

# ── Optional SSO (Azure AD / Entra) ────────────────────────────────────────────
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Encrypts per-project integration access tokens at rest. Falls back to MFA_ENCRYPTION_KEY.
INTEGRATION_ENCRYPTION_KEY="REPLACE_openssl_rand_base64_32"
